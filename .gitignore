# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# Editors / OS
.idea/
.vscode/
.DS_Store

# Data: raw and derived files are never committed, only their manifests
data/*
!data/README.md
!data/manifests/
!data/manifests/**
!data/bom/
data/bom/*
!data/bom/SOURCES.md
!data/bom/1830/
!data/bom/reports/
!data/bom/align_*.jsonl
!data/bom/diff_*.jsonl
!data/bom/jsp_*_toc.json
!data/bom/segments/
!data/bom/segments/**
!data/kjv/
!data/kjv/**
!data/catalog/
!data/catalog/**
# Derived, rebuilt in seconds by metadata.catalog / metadata.genre. Keep
# data/catalog/ for the source indexes the ingests wrote.
# catalog.parquet IS tracked (70 MB). It is the join key for every derived table we publish:
# genre.parquet maps work_id -> genre, and without the catalog those ids mean nothing. A
# replicator who obtains the sources themselves can then apply our labels without re-running
# anything, which is the point of BOM-44.
# data/catalog/genre.parquet is NOT ignored: it is ~40 hours of local model time, it lives on
# a disk with no Time Machine destination, and at a few MB it costs git almost nothing. The
# large catalog.parquet stays out because it rebuilds from the committed source catalogs in
# about 26 seconds.
!data/candidates/
!data/candidates/**
# BOM-42: the claims register is a small tracked index, like the catalogs.
!data/claims/
!data/claims/**
# BOM-41: small newspaper text sets pulled from library archives (text layer + page index);
# the page PDFs stay under data/corpus/.
!data/newspapers/
!data/newspapers/**
# BOM-14 OCR quality scores and BOM-33 access evidence. Small, derived, and referenced by
# committed docs -- a fresh clone needs them or docs/access-evidence.md points at nothing.
!data/ocr_quality/
!data/ocr_quality/**
!data/access/
!data/access/**
!data/lexicon/
!data/lexicon/**

# Large corpora: local disk only, never a git repo; tracked by manifests
data/corpus/

# Private data repo (lifehug/bom-authorship-data), cloned by scripts/data_clone.sh
data/private/

# Models and large artifacts
models/
*.pt
*.safetensors
*.bin

# Job logs
logs/

# Credentials. Never commit these. .git/info/exclude protected only this clone;
# this travels with the repo so a fresh clone on another machine is covered too.
.env
.env.*
!.env.example

# resume state of the Advantage probe, rebuilt by the pull
data/newspapers/*/probed_misses.txt

# MinHash signatures: ~545 MB, regenerate in ~2.6 h. Resumability comes from the shard
# files on disk, not from git. The outputs (duplicates.parquet, author_words.parquet) are
# small and ARE committed -- the test is cost to reproduce, not whether a file is derived.
data/catalog/signatures/
data/catalog/signatures_superseded/

# The validation page and sample carry 700-char excerpts, 30 of them Harvard Institutional
# Books (noncommercial, no redistribution) and many Internet Archive items whose rights vary.
# validation_index.json is committed instead: ids, strata and labels, enough to redraw the
# identical sample from a corpus copy. Regenerate the page with `metadata.validation build`.
data/catalog/validation.html
data/catalog/validation_sample.json
!data/kjv_mask/
!data/kjv_mask/**
