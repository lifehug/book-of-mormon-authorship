<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- BOM-65: weekly B2 backup of data/corpus/ (Sundays 03:00). Install: docs/backup.md -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.bom.b2backup</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/ea/Workspace/book-of-mormon-authorship/scripts/b2_backup.sh</string>
    <string>weekly</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string></dict>
  <key>StartCalendarInterval</key>
  <dict><key>Weekday</key><integer>0</integer><key>Hour</key><integer>3</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardOutPath</key><string>/Users/ea/Workspace/book-of-mormon-authorship/logs/b2_weekly.out</string>
  <key>StandardErrorPath</key><string>/Users/ea/Workspace/book-of-mormon-authorship/logs/b2_weekly.out</string>
</dict>
</plist>
